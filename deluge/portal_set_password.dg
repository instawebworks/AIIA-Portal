// =====================================================================
//  Zoho CRM standalone function:  portal_set_password
//
//  Hashes a plain-text password and stores it on the contact, so nobody
//  has to type a hash by hand. Run it from the function editor's
//  "Execute" button, or wire it to a custom button on Contacts.
//     Arguments: contactId (string), newPassword (string)
// =====================================================================
string standalone.portal_set_password(string contactId, string newPassword)
{
	PASSWORD_FIELD = "Portal_Password";
	PEPPER = "aiia-portal-2026";
	// PEPPER must be identical in portal_login.
	if(ifnull(newPassword,"").length() < 6)
	{
		return "Password must be at least 6 characters.";
	}
	hash = zoho.encryption.sha256(PEPPER + newPassword);
	update = Map();
	update.put(PASSWORD_FIELD,hash);
	resp = zoho.crm.updateRecord("Contacts",contactId.toLong(),update);
	info resp;
	return "Stored hash for contact " + contactId + ": " + hash;
}
