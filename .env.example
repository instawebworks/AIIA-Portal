# Full REST API URL of the standalone Deluge function "portal_login".
# Zoho CRM > Setup > Developer Hub > Functions > portal_login > "..." > REST API > enable "API Key" and copy the URL.
# Match the data centre of the org (zohoapis.com / zohoapis.com.au / zohoapis.in / zohoapis.eu).
ZOHO_PORTAL_LOGIN_URL=https://www.zohoapis.com/crm/v7/functions/portal_login/actions/execute?auth_type=apikey&zapikey=PASTE_KEY

# Random string, 32+ chars. Signs the session cookie.  Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string
